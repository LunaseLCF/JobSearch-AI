<!DOCTYPE html>
<html lang="en" data-type="software" data-radius="soft" data-buttons="solid">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="page-type" content="software">
  <meta name="site-kind" content="software">
  <meta name="description" content="Search live jobs, match listings to your profile, track applications, and generate tailored CVs and interview prep in one workspace.">
  <meta name="theme-color" content="#050718">
  <meta property="og:type" content="website">
  <meta property="og:title" content="AI Job Search — your career assistant">
  <meta property="og:description" content="Search live jobs, match listings to your profile, track applications, and prepare interviews in one workspace.">
  <title>AI Job Search — career assistant</title>
  <link rel="icon" href="/favicon.ico">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a class="skip-link" href="#page-content">Skip to main content</a>
  <div id="app">
    <!-- Sidebar -->
    <nav class="sidebar">
      <div class="sidebar-header">
        <div class="logo">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 100 100" fill="none">
              <circle cx="50" cy="50" r="42" stroke="var(--accent-3)" stroke-width="7"/>
              <path d="M31 51 45 65 70 36" stroke="var(--accent-3)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span>AI Job Search</span>
        </div>
      </div>
      <ul class="nav-items">
        <li><button class="nav-item active" data-page="dashboard" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          <span>Dashboard</span>
        </button></li>
        <li><button class="nav-item" data-page="search" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <span>Job Search</span>
        </button></li>
        <li><button class="nav-item" data-page="evaluate" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11H5a2 2 0 0 0-2 2v7h6V11z"/><path d="M14 7h-4v13h4V7z"/><path d="M19 4h-4v16h4V4z"/></svg>
          <span>Evaluate Fit</span>
        </button></li>
        <li><button class="nav-item" data-page="apply" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          <span>Apply Workflow</span>
        </button></li>
        <li><button class="nav-item" data-page="tracker" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          <span>Tracker</span>
        </button></li>
        <li><button class="nav-item" data-page="interview" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <span>Interview Prep</span>
        </button></li>
        <li><button class="nav-item" data-page="salary" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <span>Salary Lookup</span>
        </button></li>
        <li><button class="nav-item" data-page="profile" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span>Profile</span>
        </button></li>
        <li><button class="nav-item" data-page="queries" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <span>Search Queries</span>
        </button></li>
      </ul>
      <div style="margin-top:auto;padding-top:12px;border-top:1px solid var(--stroke)">
        <p style="color:var(--muted);font-size:var(--fs-11);margin:0 0 8px;text-transform:uppercase;letter-spacing:.04em">Tools</p>
        <ul class="nav-items nav-secondary">
          <li><button class="nav-item" data-page="repo" type="button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            <span>Repo Browser</span>
          </button></li>
          <li><button class="nav-item" data-page="report" type="button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span>HTML Report</span>
          </button></li>
          <li><button class="nav-item" data-page="llm-config" type="button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 6v6m11-7h-6m-6 0H1m15.364-6.364l-4.243 4.243m-4.242 0L4.636 5.636m12.728 12.728l-4.243-4.243m-4.242 0L4.636 18.364"/></svg>
            <span>LLM Config</span>
          </button></li>
          <li id="admin-nav-item" hidden><button class="nav-item" data-page="admin" type="button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1 3 5v6c0 5 3.8 9.2 9 11 5.2-1.8 9-6 9-11V5z"/><path d="m9 12 2 2 4-4"/></svg>
            <span>Admin</span>
          </button></li>
        </ul>
      </div>
      <div class="language-switcher">
        <label for="language-select">Language</label>
        <select id="language-select" class="form-select" onchange="setLanguage(this.value)">
          <option value="en">EN</option>
          <option value="th">TH</option>
          <option value="cn">中文</option>
        </select>
      </div>
      <div class="sidebar-footer">
        <div class="account-panel" id="account-panel" style="display:none">
          <div class="account-info">
            <span id="account-email" class="account-email"></span>
            <span id="account-plan" class="badge badge-active"></span>
          </div>
          <button class="btn btn-secondary btn-sm" onclick="logoutUser()">Log out</button>
        </div>
        <div class="profile-status" id="profile-status">
          <div class="status-ring" id="status-ring"></div>
          <span>Profile: <span id="profile-pct">0%</span></span>
        </div>
      </div>
    </nav>

    <!-- Main content -->
    <main class="main-content" id="page-content" tabindex="-1">
    </main>
  </div>

  <div id="auth-overlay" class="auth-overlay" style="display:none">
    <div class="auth-card">
      <h2 id="auth-title">Sign in</h2>
      <p class="auth-subtitle">AI Job Search</p>
      <div id="auth-error" class="alert alert-danger" style="display:none"></div>
      <form id="auth-form" onsubmit="submitAuth(event)">
        <div class="form-group" id="auth-name-group" style="display:none">
          <label>Name</label>
          <input type="text" id="auth-name" class="form-input" autocomplete="name">
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" id="auth-email" class="form-input" autocomplete="username" required>
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" id="auth-password" class="form-input" autocomplete="current-password" minlength="8" required>
        </div>
        <button type="submit" id="auth-submit" class="btn btn-primary" style="width:100%">Sign in</button>
      </form>
      <p class="auth-switch"><a href="#" id="auth-switch" onclick="event.preventDefault(); toggleAuthMode()">Need an account? Register</a></p>
    </div>
  </div>

  <script src="/js/i18n.js"></script>
  <script>
    // Set the saved language before the app renders its first page.
    if (window.initI18n) initI18n();
  </script>
  <script src="/js/app.js?v=1795423127"></script>
</body>
</html>
