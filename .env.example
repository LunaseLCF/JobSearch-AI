# AI Job Search Web — Environment template
# Copy to .env for the Node backend. Never commit the filled-in .env file.

# Server
PORT=3000
NODE_ENV=production

# Public URL of the frontend (Netlify site). Used in password-reset emails.
APP_BASE_URL=https://your-site.netlify.app

# Set to true when users reach the app over HTTPS through Netlify.
COOKIE_SECURE=true

# Optional: limit outgoing HTTP requests per second.
# MAX_CONCURRENT_REQUESTS=10

# PDF generation. The Docker image sets this automatically.
# CHROME_PATH=/usr/bin/chromium

# Optional: source repository path for the Repo Browser feature.
# Do not point this at the whole app if you do not want users browsing app files.
# REPO_DIR=/app/ai-job-search

# Password reset email (SMTP)
# If SMTP_HOST is blank, reset emails are written to data/outbox/ instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=no-reply@example.com

# Netlify build environment variable (set in Netlify UI, not here):
# BACKEND_ORIGIN=https://your-backend-host.example.com
